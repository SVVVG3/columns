# Copy this file to .env.local and fill in your values

# Neynar API key — get from https://dev.neynar.com
NEYNAR_API_KEY=your_neynar_api_key_here

# Columns app Farcaster account (@columns) — custody mnemonic + FID for "sent from Columns"
# Export the Farcaster recovery phrase (not the in-app wallet phrase). Server-only.
FARCASTER_DEVELOPER_MNEMONIC=word1 word2 word3 ...
FARCASTER_DEVELOPER_FID=3335546

# Canonical site URL for Open Graph / share previews (optional; defaults to https://mycolumns.xyz)
# NEXT_PUBLIC_APP_URL=https://mycolumns.xyz

# Secret for iron-session cookie encryption (generate with: openssl rand -base64 32)
SESSION_SECRET=your_32_char_minimum_random_secret_here

# Private beta (optional) — password before SIWN + FID allowlist after sign-in
# BETA_GATE_ENABLED=true
# BETA_ACCESS_PASSWORD=your_shared_beta_password
# ALLOWED_FIDS=12345,67890

# CoinDesk Data API key (optional) — news column works without one; add for higher limits.
# Get from https://developers.coindesk.com/settings/api-keys
# COINDESK_API_KEY=your_coindesk_api_key_here

# Hypersnap node for free unauthenticated reads (no API key needed).
# Defaults to the public Quilibrium node — override with your own if self-hosting.
# HYPERSNAP_URL=https://haatz.quilibrium.com

# Cloudflare R2 — cast photo uploads (required in production).
# 1. Create a bucket at https://dash.cloudflare.com → R2
# 2. Enable public access (R2.dev subdomain or custom domain on your zone)
# 3. Create an API token with Object Read & Write on that bucket
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_bucket_name
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
#    (or https://media.yourdomain.com if using a custom domain — no trailing slash)
